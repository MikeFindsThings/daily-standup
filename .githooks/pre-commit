#!/bin/sh
# Blocks commits that contain secrets. Enable once per clone:
#   git config core.hooksPath .githooks

blocked=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)|\.pem$|\.key$|(^|/)credentials(\.|$)|(^|/)secrets?\.' )
if [ -n "$blocked" ]; then
  echo "Commit blocked: credential-type files are staged:"
  echo "$blocked"
  exit 1
fi

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "Commit blocked: gitleaks is not installed (brew install gitleaks)."
  exit 1
fi

gitleaks git --pre-commit --staged --redact --no-banner . || {
  echo "Commit blocked: gitleaks found a possible secret in the staged changes."
  exit 1
}
